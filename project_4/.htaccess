# ==========================================
# 1. التخزين المؤقت وتحسين سرعة التحميل (Browser Caching)
# ==========================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # تخزين الصور وفيديوهات وأيقونات الموقع لمدة سنة
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # تخزين ملفات التنسيق والسكريبتات لمدة سنة
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>


# ==========================================
# 2. قواعد إعادة التوجيه وتحسين الروابط (URL Rewriting & SEO)
# ==========================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # أ) فرض تشغيل الموقع بـ HTTPS (حماية SSL الأمان)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ب) إزالة كلمة index.html نهائياً من شريط العنوان وتحويل الرابط لـ Slash نظيفة
    RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
    RewriteRule ^(.*?)index\.html$ /$1 [R=301,L,NC]

    # ج) إخفاء امتداد .html من الروابط لتبدو احترافية (مثل /about بدلاً من /about.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>